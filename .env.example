# Contentful CMS Configuration
VITE_CONTENTFUL_SPACE_ID=your_contentful_space_id
VITE_CONTENTFUL_ACCESS_TOKEN=your_contentful_delivery_token
VITE_CONTENTFUL_PREVIEW_TOKEN=your_contentful_preview_token
VITE_CONTENTFUL_ENVIRONMENT=master

# Analytics Engine (Supabase Postgres) - server-side only, never prefix the service key with VITE_
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Owner dashboard authentication (required; login is disabled if unset)
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_SECRET=at_least_32_random_characters_eg_openssl_rand_hex_32
